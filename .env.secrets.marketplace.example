# Template for the WeFarm marketplace web app's keys (agriphilo/: requester, player, QA, Data Miner, AI Player).
# The browser simulator (web/) needs none of these. World Labs keys are kept in a separate file.
#
# Copy this file OUTSIDE the repository, next to the repository folder, and fill it in:
#   cp .env.secrets.marketplace.example ../.env.secrets.marketplace
# Never commit the filled-in copy. Every value is optional; without one, the matching feature
# reports itself as unavailable instead of pretending to work.

# OpenRouter: reads the requester's data request and gives the QA verdict on each episode.
# Without it, episodes stay "pending" and can't be bought.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_QA_MODEL=

# Crusoe: written QA explanations (agriphilo/crusoe.py). CURSOE_API_KEY is also accepted.
CRUSOE_API_KEY=
# CRUSOE_MODEL=

# Crusoe AI Player (AI Mode in the simulator): an OpenAI-compatible chat endpoint and a vision model.
# AI Mode stays unavailable unless both the endpoint and the model are set.
CRUSOE_VLM_ENDPOINT=
CRUSOE_VLM_MODEL=
CRUSOE_VLM_API_KEY=

# Neo4j AuraDB: task, episode, QA, and purchase metadata for the Data Miner.
# Without it, a local JSON index is used. NEO4J_PW and NEO4J_USER are also accepted.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Stripe test mode for credit top-ups (sk_test_… only). Without it, top-ups are instant test credits.
STRIPE_SECRET_KEY=
